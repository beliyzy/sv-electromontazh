{
  "name": "СВ Электромонтаж",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postCreateCommand": "npm ci && node .devcontainer/setup-env.mjs",
  "postAttachCommand": "npm run dev",
  "forwardPorts": [5173, 5174],
  "portsAttributes": {
    "5173": { "label": "Сайт", "onAutoForward": "openBrowser" },
    "5174": { "label": "Админка (/admin/)", "onAutoForward": "notify" },
    "3000": { "label": "API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
